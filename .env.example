# ============================================================================
# ChatGPT2API — mẫu biến môi trường  (copy sang .env rồi điền giá trị thật)
# Chi tiết: docs/BAO_MAT_VA_NANG_CAP_2026-08.md
# ============================================================================

# ── BẮT BUỘC — thiếu là deploy dừng ngay (compose dùng ${VAR:?required}) ────

# Khoá admin của API + dashboard
CHATGPT2API_AUTH_KEY=doi_thanh_khoa_manh_cua_ban

# Xác thực nội bộ tới captcha-solver (đăng nhập web ChatGPT/Gemini/Flow).
# LƯU Ý: nếu đặt KHÁC CHATGPT2API_AUTH_KEY thì phải sửa
# Settings → Flow → captcha_solver_api_key cho khớp, nếu không sẽ 401.
CAPTCHA_SOLVER_API_KEY=doi_thanh_khoa_manh_cua_ban

# Bearer cho Home Assistant / API gọi zalo-server (:3001).
# PHẠM VI: chỉ các route GỬI nội dung (tin, ảnh, album, tệp, video, sticker).
# Đọc lịch sử chat, tra người dùng, tạo/sửa nhóm, kết bạn và dashboard đều cần
# đăng nhập tài khoản admin — key này gọi vào đó sẽ nhận 403.
ZALO_SERVER_API_KEY=doi_thanh_khoa_manh_cua_ban

# Mật khẩu noVNC (:6080) — cổng này KHÔNG được mở ra Internet
VNC_PASSWORD=doi_thanh_mat_khau_manh

# Chỉ cần khi STORAGE_BACKEND=postgres
# DB_PASSWORD=mat_khau_postgres

# ── KHUYẾN NGHỊ cho production ─────────────────────────────────────────────

# Bí mật ký session của zalo-server. Không đặt → app tự sinh ngẫu nhiên mỗi lần
# chạy, nghĩa là MỌI phiên đăng nhập mất sau mỗi restart.
# Tạo bằng:  openssl rand -base64 48
SESSION_SECRET=

# Mật khẩu admin zalo-server. Dùng khi seed lần đầu (chưa có users.json); bot
# Python đọc CÙNG biến này để đăng nhập nội bộ. Không đặt → seed mật khẩu ngẫu
# nhiên và bot sẽ không đăng nhập được.
ZALO_SERVER_ADMIN_PASSWORD=

# Khoá mã hoá mật khẩu và HẠT GIỐNG TOTP trong `data/accounts.db` (AES-256-GCM).
# Không đặt → hai thứ đó nằm dạng chữ thường, đi theo mọi bản sao lưu. Hạt giống
# TOTP không phải "mã 6 số": nó sinh ra MỌI mã 6 số từ nay về sau.
#
# Phải là base64 của ĐÚNG 32 byte. Sai định dạng thì hệ thống ghi một dòng log
# rồi lặng lẽ quay về lưu chữ thường — đặt VAULT_REQUIRE_ENCRYPTION=1 để biến
# tình huống đó thành từ chối ghi.
#
# ĐẶT RỒI THÌ ĐỪNG ĐỔI, ĐỪNG MẤT: dữ liệu đã mã hoá mà sai khoá thì giải ra
# rỗng, mọi mật khẩu và hạt giống đã lưu phải nhập lại từ đầu. Lưu khoá ở nơi
# khác ngoài máy chủ.
#
# Tạo bằng:  python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=
VAULT_REQUIRE_ENCRYPTION=1

# ── TUỲ CHỌN ───────────────────────────────────────────────────────────────

# Tên đăng nhập dashboard zalo-server (mặc định: admin)
ZALO_SERVER_ADMIN_USERNAME=admin

# Cookie Secure cho zalo-server. GIỮ "0" trừ khi zalo-server CHỈ truy cập qua
# HTTPS: bot Python gọi http://127.0.0.1:3001 và giữ session cookie, đặt "1" là
# bot mất phiên → kênh Zalo cá nhân ngừng hoạt động.
ZALO_COOKIE_SECURE=0
# Gioi han tai nguyen cho zalo-server (gia tri mac dinh an toan; co the giam).
ZALO_JSON_BODY_LIMIT=2mb
ZALO_FORM_BODY_LIMIT=2mb
ZALO_FILE_DOWNLOAD_MAX_BYTES=157286400
ZALO_IMAGE_DOWNLOAD_MAX_BYTES=26214400
ZALO_WEBHOOK_TIMEOUT_MS=10000
ZALO_VIDEO_UPLOAD_TIMEOUT_MS=180000
ZALO_VIDEO_THUMBNAIL_TIMEOUT_MS=30000
ZALO_GROUP_HISTORY_MAX_MESSAGES=5000
ZALO_GROUP_HISTORY_MAX_FILE_BYTES=20971520

# Origin được phép mở WebSocket của zalo-server (phẩy ngăn cách). Để TRỐNG =
# dùng luật same-host (an toàn). Chỉ khai origin của CHÍNH zalo-server, không
# phải domain của app chính, kẻo chặn nhầm trang chat.
# ZALO_WS_ALLOWED_ORIGINS=

# Bật các endpoint debug của zalo-server (test-login, debug-users-file…).
# PRODUCTION: đừng đặt.
# ZALO_DEV_ENDPOINTS=1

# URL công khai để dựng link ảnh (khi chạy sau tunnel/reverse proxy)
# CHATGPT2API_BASE_URL=https://your-domain.com

# Máy GPU tách riêng lời thoại, giữ nhạc/hiệu ứng để lồng TTS. Bắt buộc cho
# lựa chọn "Lồng tiếng video"; xem deploy/gpu-box/docker-compose.tach-am.yml.
# TACH_AM_URL_GPU=http://172.16.10.220:5004
# Khóa ngẫu nhiên dài, phải giống SEPARATOR_API_TOKEN trên máy GPU.
# TACH_AM_API_TOKEN=thay-bang-chuoi-ngau-nhien-dai

# Giá vàng BTMC (gồm cả giá spot PNJ/DOJI/Phú Quý) trong MCP vn_currency.
# KHÔNG cần đặt: mã nguồn dùng sẵn khoá mà chính BTMC đăng công khai trong tài
# liệu API của họ. Chỉ khai biến này nếu BTMC đổi khoá công bố.
# BTMC_API_KEY=

# Cặp OAuth client của Antigravity. Google xếp client secret của ứng dụng
# desktop là "non-confidential" (nó nằm sẵn trong bản cài), nên mã nguồn có giá
# trị mặc định dùng được ngay. Chỉ khai hai biến này khi bạn dùng OAuth client
# của riêng mình — và phải khai CẢ CẶP, lệch một cái là Google từ chối.
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=

# ============================================================================
# Lưu trữ
# ============================================================================

# json | sqlite | postgres | git   (mặc định: json)
STORAGE_BACKEND=json

# PostgreSQL
# DATABASE_URL=postgresql://user:password@host.docker.internal:5432/c2a_db

# Supabase
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite (không đặt thì tự dùng data/accounts.db)
# DATABASE_URL=sqlite:///app/data/accounts.db

# ── Git backend (khi STORAGE_BACKEND=git) ──────────────────────────────────
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git
# GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GIT_BRANCH=main
# GIT_FILE_PATH=accounts.json
