# Thông tin đăng nhập kho đám mây (token Drive/Drime/MEGA…) — chưa bao giờ được
# lên git. Xem `services/rclone_service.py`: tệp này nằm ngoài config.json, mode
# 0600, và giao diện chỉ hiện bản đã che.
data/rclone/
deploy/*
# …except build-critical files used by the unified Dockerfile (no secrets)
!deploy/supervisord.conf
!deploy/extra-requirements.txt
!deploy/cloudflare-gemini-proxy.js
# Agent người dùng TẢI VỀ rồi cài lên máy/điện thoại/VPS của họ — phải nằm
# trong repo mới lấy được. Không chứa bí mật: token truyền qua tham số dòng
# lệnh hoặc biến môi trường C2A_TOKEN, không hardcode trong file.
!deploy/device_agent/
# settings.yml của SearXNG: KHÔNG chứa bí mật — secret_key truyền qua biến
# môi trường SEARXNG_SECRET. File này phải theo repo vì `search.formats` không
# có biến môi trường tương ứng, thiếu nó là mọi ?format=json trả 403.
!deploy/searxng/
!deploy/searxng/settings.yml
!deploy/device_agent/c2a_agent.py
!deploy/device_agent/README.md
# Compose chạy RIÊNG máy dịch LibreTranslate. KHÔNG chứa bí mật: chỉ tên image,
# cờ LT_* và tên mạng. Xem docs/DICH_LIBRETRANSLATE.md.
!deploy/libretranslate/
# Compose + README của MÁY GPU (fw-nghe + vn-translate-gpu). Phải theo repo thì
# người dùng mới `docker compose up -d` được. KHÔNG chứa bí mật: chỉ tên image
# trên ghcr, cổng và cờ FW_*/TT_*.
!deploy/gpu-box/
!deploy/libretranslate/docker-compose.yml
