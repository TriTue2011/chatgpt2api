# URL của C2A. Bot chạy bằng Docker thì 127.0.0.1 là chính container bot, KHÔNG
# phải máy chủ -- điền IP LAN của máy chạy C2A (vd http://192.168.0.50:3030),
# hoặc tên service nếu chạy chung network compose với C2A (vd http://c2a:3030).
C2A_BASE_URL=http://127.0.0.1:3030

# Admin API key tĩnh của C2A — Settings -> Bảo mật -> API Key quản trị
# (chính là config.auth_key mà api/support.py::_legacy_admin_identity so khớp).
# Dùng để gọi POST /api/zalo-personal/test-send đẩy cảnh báo chủ động, VÀ cũng
# chính là mật khẩu đăng nhập trang quản lý /ui (POST /ui/dang-nhap) — để trống
# thì trang /ui/login sẽ báo "chưa cấu hình" và không đăng nhập được.
C2A_AUTH_KEY=

# thread_id Zalo CÁ NHÂN (kênh zca-js, KHÔNG phải bot_id/chat_id của kênh Bot
# API chính thức — 2 kênh Zalo của C2A tách biệt hoàn toàn, không chia sẻ
# token/trạng thái). Đây là Zalo user ID thật của người nhận cảnh báo, KHÔNG có
# giá trị mặc định hợp lệ ("để trống" sẽ khiến gui_canh_bao() raise RuntimeError
# sớm thay vì gửi mù).
#
# Cách lấy: nếu người nhận đã từng chat với bot qua kênh Zalo Cá Nhân, xem
# log C2A (`docker logs c2a | grep zalop`) — user_id dạng
# "v1|zalop|<thread_id>||"; hoặc GET /api/zalo-personal/status (admin_thread)
# nếu đã được C2A tự nhận admin.
C2A_ZALO_PERSONAL_THREAD_ID=

# Cổng HTTP của bot (/mcp cho C2A, /ui + /api cho trang quản lý). Đăng ký
# http://<IP-máy-chạy-bot>:<cổng>/mcp vào C2A Settings -> MCP Servers.
MCP_SERVER_PORT=8801

# Gốc URL của chính bot -- ghép vào link PDF giải chi tạm ứng gửi qua chat
# (người dùng bấm mở bằng trình duyệt điện thoại). Để trống =
# http://localhost:<MCP_SERVER_PORT>, chỉ mở được trên chính máy chủ -- đặt IP
# LAN hoặc tên miền, vd http://192.168.0.50:8801
SELF_BASE_URL=

# Đường dẫn SQLite (mặc định data/chi_tieu.db cạnh project)
DB_PATH=data/chi_tieu.db

# Chu kỳ kiểm tra cảnh báo vượt hũ (giây). Mặc định 1800 = 30 phút.
ALERT_CHECK_INTERVAL_SECONDS=1800
