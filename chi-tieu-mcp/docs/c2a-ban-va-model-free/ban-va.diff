+def _is_expense_query(text: str) -> bool:
+    """True for a chi-tieu-bot (ngân sách cá nhân JARS 6-hũ) query."""
+    t = _chu_thuong(text)
+    return any(_co_tu(t, kw) for kw in _EXPENSE_KEYWORDS) or bool(_MONEY_AMOUNT_RE.search(t))
+
+
+# Trần payload ChatGPT Free (backend 413 quanh 45 KB) — cùng ngưỡng với nhánh
+# combo_skip_free_oversized, đo trên payload ĐÃ rút gọn như _dispatch gửi đi.
+_FREE_PAYLOAD_LIMIT = 42_000
+
+
+def _free_payload_bytes(messages: list[dict[str, Any]], tools: list[dict[str, Any]] | None) -> int:
+    """Kích thước model free nhận: messages (bỏ ảnh base64) + tool đã rút gọn."""
+    slim_tools = _slim_tools_for_free(tools)
+    raw_json = json.dumps(messages, ensure_ascii=False, default=str)
+    slim_json = re.sub(r'"data:image/[^;]+;base64,[^"]+"', '""', raw_json)
+    return (len(slim_json.encode("utf-8"))
+            + len(json.dumps(slim_tools or [], ensure_ascii=False, default=str).encode("utf-8")))
+
+
+def _trim_free_expense_tools(
+    tools: list[dict[str, Any]] | None, messages: list[dict[str, Any]], user_text: str,
+) -> list[dict[str, Any]] | None:
+    """Tin chi tiêu mà payload vượt trần ChatGPT Free → chỉ giữ tool chi-tieu-bot.
+
+    Bước 1 của agent mang cả ~90 tool năng lực (≈104 KB, đo 25/09/2026) nên cgf
+    luôn bị loại; khi các model gọi được tool khác cạn quota, "ăn sáng 30k" rơi
+    xuống model không có tool và nó BỊA "đã ghi". Ghi đúng khoản chi quan trọng
+    hơn các năng lực khác của lượt này. Trả None (giữ hành vi cũ: bỏ qua cgf) khi
+    không phải tin chi tiêu, danh sách không có tool chi tiêu, hoặc rút rồi vẫn
+    vượt trần.
+    """
+    if not tools or not _is_expense_query(user_text):
+        return None
+    rut = _chi_tool_chi_tieu(tools)
+    if not rut or _free_payload_bytes(messages, rut) > _FREE_PAYLOAD_LIMIT:
+        return None
+    return rut
+
+
+def _chi_tool_chi_tieu(tools: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Lọc giữ tool của server chi-tieu-bot (theo tên đã expose)."""
+    try:
+        from services.mcp_client import get_expense_mcp_tools
+        ten = {(t.get("function") or {}).get("name") for t in get_expense_mcp_tools()}
+    except Exception:
+        return []
+    return [t for t in tools if (t.get("function") or {}).get("name") in ten]
+
+
+# Đo thật 25/09: tin nhắn ≈29,7 KB + 11 tool chi tiêu đủ mô tả (12,8 KB)
+# = 42,5 KB — vẫn vượt trần ~500 byte. Bản gọn (mô tả ≤420 ký tự, bỏ title)
+# ≈7 KB. Phần cắt đi là hướng dẫn dài; quy tắc chi vượt tổng vẫn nằm trong
+# tham số (xac_nhan_vuot_tong mặc định False) và được nhắc lại trong kết quả tool.
+_FREE_EXPENSE_DESC_MAX = 420
+
+
+def _compact_expense_tools(tools: list[dict[str, Any]] | None) -> list[dict[str, Any]]:
+    """Bản gọn (bản sao, không sửa cache MCP) của tool chi-tieu-bot cho model free."""
+    import copy
+    out: list[dict[str, Any]] = []
+    for t in tools or []:
+        t = copy.deepcopy(t)
+        fn = t.get("function") or {}
+        mo_ta = re.sub(r"\s+", " ", str(fn.get("description") or "")).strip()
+        if len(mo_ta) > _FREE_EXPENSE_DESC_MAX:
+            cat = mo_ta[:_FREE_EXPENSE_DESC_MAX]
+            cham = cat.rfind(". ")
+            mo_ta = cat[:cham + 1] if cham > _FREE_EXPENSE_DESC_MAX // 2 else cat
+        fn["description"] = mo_ta
+        params = fn.get("parameters")
+        if isinstance(params, dict):
+            params.pop("title", None)
+            for p in (params.get("properties") or {}).values():
+                if isinstance(p, dict):
+                    p.pop("title", None)
+        out.append(t)
+    return out
+
+
+def _stash_free_expense_tools(body: dict[str, Any], route, tools: list[dict[str, Any]] | None,
+                              user_text: str) -> None:
+    """Ghi nhớ bộ tool ĐÃ gửi cho model free ở tin chi tiêu, cho lượt gọi tiếp.
+
+    Lượt tiếp trong _execute_mcp_tools_in_response tự nạp lại body["tools"]
+    (~90 tool năng lực) → vượt trần → lỗi SAU khi tool ghi sổ đã chạy → agent thử
+    lại → có thể ghi trùng. Gọi cho MỌI route để route sau xoá ghi nhớ cũ.
+    """
+    body.pop("_free_expense_tools", None)
+    if getattr(route, "provider", "") != "chatgpt_free" or not tools \
+            or not _is_expense_query(user_text):
+        return
+    if _chi_tool_chi_tieu(tools):
+        body["_free_expense_tools"] = {"model": getattr(route, "model", ""),
+                                       "tools": list(tools), "user_text": user_text}
+
+
+def _followup_tools(body: dict[str, Any], route,
+                    messages: list[dict[str, Any]]) -> list[dict[str, Any]] | None:
+    """Bộ tool cho lượt gọi tiếp của cùng route; None = để nguyên cách cũ."""
+    nho = body.get("_free_expense_tools")
+    if not nho or nho.get("model") != getattr(route, "model", ""):
+        return None
+    tools = nho["tools"]
+    if _free_payload_bytes(messages, tools) <= _FREE_PAYLOAD_LIMIT:
+        return tools
+    # Vượt trần (thêm kết quả tool): rút về tool chi tiêu — kể cả khi vẫn vượt,
+    # bản nhỏ nhất vẫn hơn nạp lại 90 tool.
+    return _chi_tool_chi_tieu(tools) or tools
+
+
+# Bản vá tại chỗ 25/09/2026 (v3). Lỗi thật: v2 đưa đủ 11 tool chi tiêu (38 KB)
+# cho cgf, nhưng "Chi 30k ăn sáng" vẫn được trả lời bằng chữ "em ghi nhận khoản
+# chi…" — không có khối ```xml <tool_call>```, sổ không có dòng mới. Tóm tắt phiên
+# có sẵn "Đã ghi nhận chi tiêu: ăn sáng 30.000đ" của lần trước nên model coi khoản
+# mới giống hệt là tin lặp. Với ChatGPT Free, gọi tool chỉ là lời dặn trong prompt.
+#
+# Chỉ ép với tin NGẮN, có số tiền, không phải câu hỏi: tin dán dài có số tiền (phiếu
+# lương) hay "giá vàng 12 triệu à?" mà bị ép thì model có thể ghi bừa một khoản.
+_TIN_GHI_CHI_MAX = 160
+_CAU_HOI_RE = re.compile(
+    r"\?|(?<!\w)(?:bao nhiêu|thế nào|như nào|có nên|được không|tại sao|vì sao|còn không)(?!\w)")
+_XAC_NHAN_DA_GHI_RE = re.compile(
+    r"(?<!\w)(?:đã|vừa)\s+(?:được\s+)?(?:ghi|lưu|thêm|cập nhật|nhập)(?!\w)"
+    r"|(?<!\w)ghi\s+nhận(?!\w)|(?<!\w)ghi\s+xong(?!\w)")
+_CANH_BAO_CHUA_GHI = (
+    "⚠️ Em CHƯA ghi được khoản này vào sổ chi tiêu — AI đang trục trặc, không gọi được "
+    "lệnh ghi. Anh nhắn lại giúp em sau ít phút, hoặc thêm tay tại "
+    "<địa chỉ trang /ui> nha.")
+
+
+def _free_expense_bat_buoc(route, tools: list[dict[str, Any]] | None, user_text: str,
+                           tool_choice: Any) -> list[dict[str, Any]] | None:
+    """Bộ tool chi-tieu-bot để ép lượt đầu gọi tool, hoặc None (giữ nguyên cách cũ)."""
+    if getattr(route, "provider", "") != "chatgpt_free" or tool_choice not in (None, "auto"):
+        return None
+    t = _chu_thuong(user_text).strip()
+    if not t or len(t) > _TIN_GHI_CHI_MAX or not _MONEY_AMOUNT_RE.search(t) \
+            or _CAU_HOI_RE.search(t):
+        return None
+    return _chi_tool_chi_tieu(tools or []) or None
+
+
+def _la_xac_nhan_chi_gia(result: dict[str, Any]) -> bool:
+    """Trả lời bằng chữ rằng đã ghi mà KHÔNG kèm lệnh gọi tool nào (native lẫn XML)."""
+    msg = ((result.get("choices") or [{}])[0].get("message")) or {}
+    if msg.get("tool_calls"):
+        return False
+    noi_dung = str(msg.get("content") or "")
+    if not noi_dung or _extract_xml_tool_calls_from_text(noi_dung):
+        return False
+    return bool(_XAC_NHAN_DA_GHI_RE.search(_chu_thuong(noi_dung)))
+
+
+def _dispatch_free_expense(route, messages, tools, tool_choice, body):
+    """Lượt đầu của tin ghi chi trên model free: bắt buộc gọi tool; bịa "đã ghi" thì
+    thử lại 1 lần, vẫn bịa thì báo CHƯA ghi — thà người dùng nhắn lại còn hơn mất khoản chi."""
+    logger.info({"event": "free_expense_tool_required", "model": getattr(route, "model", ""),
+                 "tools": len(tools or [])})
+    for lan in (1, 2):
+        result = _dispatch(route, messages, tools, "required", body)
+        if not isinstance(result, dict) or not _la_xac_nhan_chi_gia(result):
+            return result
+        noi_dung = str(((result.get("choices") or [{}])[0].get("message") or {}).get("content") or "")
+        logger.warning({"event": "free_expense_fake_confirm", "lan": lan,
+                        "model": getattr(route, "model", ""), "content": noi_dung[:160]})
+    import copy
+    out = copy.deepcopy(result)
+    choice = out["choices"][0]
+    choice["message"] = {"role": "assistant", "content": _CANH_BAO_CHUA_GHI}
+    choice["finish_reason"] = "stop"
+    return out
+
+
