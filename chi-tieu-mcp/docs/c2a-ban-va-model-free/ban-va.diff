+# ── chi-tieu-bot (ngân sách cá nhân JARS 6 hũ, MCP riêng cổng 8801) ─────────
+# Bản vá tại chỗ 25/09/2026: ChatGPT Free có trần payload ~42 KB, nên tin chi
+# tiêu gửi model free chỉ kèm tool của RIÊNG server này (11 tool ≈12,8 KB) —
+# get_relevant_mcp_tools trả mọi tool external + generic (57-73 tool), vượt
+# trần. Nhận server theo id/tên đã bỏ dấu (tên hiện tại: "Chi tiêu bot").
+def _is_expense_server(server: dict[str, Any]) -> bool:
+    import unicodedata
+    ident = " ".join(str(server.get(k) or "") for k in ("id", "name")).lower()
+    ident = "".join(c for c in unicodedata.normalize("NFD", ident)
+                    if unicodedata.category(c) != "Mn").replace("đ", "d")
+    ident = ident.replace("-", " ").replace("_", " ")
+    return "chi tieu" in ident or "chitieu" in ident
+
+
+def get_expense_mcp_tools() -> list[dict[str, Any]]:
+    """Tool (đúng tên đã expose) của server chi-tieu-bot đang bật; [] nếu không có."""
+    servers = [s for s in _configured_servers()
+               if s.get("enabled", True) and s.get("url") and _is_expense_server(s)]
+    if not servers:
+        return []
+    all_tools = get_enabled_mcp_tools()
+    keys = {_session_key(*_connection_options(s), s.get("oauth_id", "")) for s in servers}
+    names = {name for name, route in _tool_routes.items() if route[0] in keys}
+    return [t for t in all_tools if (t.get("function") or {}).get("name") in names]
+
