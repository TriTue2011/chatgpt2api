+# Từ khoá + mẫu số tiền nhận diện câu hỏi/lệnh liên quan chi-tieu-bot (ngân
+# sách cá nhân JARS 6 hũ, MCP server riêng, cổng 8801) — cùng lý do
+# _is_smarthome_query: free model bị is_free_model gate (dưới) chặn hết tool,
+# câu này cần lọt qua exemption mới gọi được ghi_chi_tieu/xem_ngan_sach/...
+# Khác smarthome (luôn có danh từ thiết bị cố định), ghi chi tiêu thường
+# KHÔNG có từ khoá tài chính rõ ràng ("cà phê sáng 20k") — nên thêm mẫu số
+# tiền kiểu Việt (20k/50 nghìn/2 triệu/20.000đ) làm tín hiệu phụ. Có thể bắt
+# nhầm câu hỏi giá vàng/cổ phiếu có nhắc số tiền — chấp nhận bắt rộng: model
+# free chỉ được kèm tool của RIÊNG server chi tiêu (≈12,8 KB, đo 25/09/2026),
+# không kéo cả 57-73 tool như get_relevant_mcp_tools.
+# Mở rộng 25/09/2026 theo các kiểu tin bị trượt (bot bịa "đã ghi", mất khoản chi):
+# "ăn sáng ba mươi ngàn" (số bằng chữ, "ngàn"), "Ghi 45.000 cà phê." (số có
+# dấu chấm), "Chi 120 tiếp khách" (số trơn ngắn), "Tạm ứng",
+# "Nhận tiền từ công ty 5000000".
+_EXPENSE_KEYWORDS = [
+    "chi tiêu", "ngân sách", "hũ thiết yếu", "hũ học tập", "hũ dự phòng",
+    "hũ hưởng thụ", "hũ gia đình", "hũ tự do tài chính", "thu nhập thêm",
+    "thu nhập phát sinh", "tạm ứng công ty", "chi công ty", "giải chi",
+    "chi phí đặc biệt", "6 hũ", "sáu hũ", "chu kỳ lương",
+    "tạm ứng", "thu nhập", "nhận tiền", "nhận lương", "đổ xăng", "tiền xăng",
+    "tiền tiêu", "đã tiêu", "khoản chi", "số dư", "hũ",
+]
+_MONEY_AMOUNT_RE = re.compile(
+    r"\d+\s*(k\b|nghìn|nghin|ngàn|ngan|triệu|trieu|tr\b|đồng|dong|vnđ|vnd|đ\b)"
+    # 60.000 / 1.500.000 / 9,000,000 — không bắt IP (10.0.0.5), số phiên bản.
+    r"|(?<![\d.,])\d{1,3}(?:[.,]\d{3})+(?![\d.,])"
+    # 9000000 — số trơn từ 5 chữ số; số điện thoại (bắt đầu bằng 0) không khớp.
+    r"|(?<![\d.,])[1-9]\d{4,9}(?![\d.,])"
+    # sáu mươi ngàn / hai triệu rưỡi / một trăm năm mươi nghìn
+    r"|(?<!\w)(?:một|hai|ba|bốn|tư|năm|lăm|sáu|bảy|tám|chín|mười|mươi|chục|trăm|rưỡi|nửa)"
+    r"\s+(?:ngàn|nghìn|triệu|tỷ|tỉ)(?!\w)"
+    # Chi 120 tiếp khách / trả 50 tiền gửi xe
+    r"|(?<!\w)(?:chi|ghi|trả|tiêu|mua|nạp|đóng|đổ)\s+\d",
+    re.IGNORECASE,
+)
+
