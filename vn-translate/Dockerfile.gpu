# vn-translate bản GPU — chạy trên máy có card NVIDIA (RTX 2060 Super, máy
# NVR .220). Dùng cho việc dịch theo LÔ (phụ đề phim, tài liệu dài): CTranslate2
# trên GPU nhanh ~10× bản CPU khi batch (benchmark chính chủ OpenNMT); câu lẻ
# vẫn đi bản CPU trên .38 — định tuyến ở services/translate_service.py.
#
# Khác Dockerfile (bản CPU) hai điểm:
# - Nền nvidia/cuda 12.4 + cuDNN 9 (ctranslate2 ≥4.5 đòi đúng cặp này;
#   driver máy NVR 590 dư chuẩn).
# - KHÔNG có tầng chuyển đổi EnViT5: chép thẳng thư mục đã convert sẵn TỪ IMAGE
#   CPU đã publish — đỡ kéo torch 800 MB về máy NVR.
#
# Bản trước bắt phải chép tay `envit5-ct2/` vào build context (`docker exec
# vn-translate tar -cC /opt envit5 | tar -x`). Thư mục đó không nằm trong git,
# nên CI build là chết ngay ở COPY — đó chính là lý do image GPU chưa bao giờ
# lên được ghcr. Lấy qua tầng `cpu` bên dưới thì cả CI lẫn máy nhà đều build
# được bằng đúng một lệnh, không có bước tay nào.
#
# Có image dựng sẵn: ghcr.io/tritue2011/vn-translate-gpu:latest
# (xem deploy/gpu-box/docker-compose.yml). Build tay khi cần:
#   docker build -f Dockerfile.gpu -t vn-translate-gpu .

# Nguồn EnViT5 đã convert. Đổi tag khi muốn ghim bản CPU cụ thể.
ARG ANH_CPU=ghcr.io/tritue2011/vn-translate:latest
FROM ${ANH_CPU} AS cpu

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# python-is-python3: entrypoint.sh (dùng chung với bản CPU nền python:3.12)
# gọi `python` — nền Ubuntu không có alias đó.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY --from=cpu /opt/envit5 /opt/envit5
COPY app ./app

COPY entrypoint.sh /entrypoint.sh
RUN useradd --system --uid 1033 vntranslate && mkdir -p /data \
    && chown 1033:1033 /data && chmod +x /entrypoint.sh
VOLUME /data
EXPOSE 5000

ENV TT_MODEL_DIR=/data/models TT_GLOSSARY_DIR=/data/glossary HOME=/data HF_HOME=/data/hf \
    TT_ENVIT5_DIR=/opt/envit5 \
    TT_THIET_BI=cuda
ENTRYPOINT ["/entrypoint.sh"]
